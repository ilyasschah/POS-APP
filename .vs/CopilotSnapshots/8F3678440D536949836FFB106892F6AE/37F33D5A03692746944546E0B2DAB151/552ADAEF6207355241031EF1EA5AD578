@page "{id:int}"
@model Api.Pages.Admin.Companies.EditModel
@{
    ViewData["Title"] = "Edit company";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Edit company #@Model.Input.Id</h3>
    <a class="btn btn-outline-secondary" asp-page="Details" asp-route-id="@Model.Input.Id">Back</a>
</div>

<form method="post" class="bg-white shadow-sm p-4 rounded">
    <input type="hidden" asp-for="Input.Id" />
    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label">Name *</label>
            <input class="form-control" asp-for="Input.Name" required />
        </div>
        <div class="col-md-6">
            <label class="form-label">Country Id *</label>
            <input type="number" class="form-control" asp-for="Input.CountryId" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Email</label>
            <input class="form-control" asp-for="Input.Email" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Phone</label>
            <input class="form-control" asp-for="Input.PhoneNumber" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Address</label>
            <input class="form-control" asp-for="Input.Address" />
        </div>
        <div class="col-md-3">
            <label class="form-label">City</label>
            <input class="form-control" asp-for="Input.City" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Postal code</label>
            <input class="form-control" asp-for="Input.PostalCode" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Tax number</label>
            <input class="form-control" asp-for="Input.TaxNumber" />
        </div>
    </div>
    <div class="mt-4">
        <button type="submit" class="btn btn-primary">Save changes</button>
    </div>
</form>
