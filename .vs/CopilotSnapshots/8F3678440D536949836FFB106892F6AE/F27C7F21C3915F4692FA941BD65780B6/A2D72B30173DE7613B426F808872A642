<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - POS Admin</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/theme.css" />
</head>
<body>
    <div class="admin-shell">
        <aside class="sidebar">
            <div class="brand">POS Admin</div>
            <nav class="nav-vertical" aria-label="Main navigation">
                <a class="nav-item @(Context.Request.Path.StartsWithSegments("/Admin/Dashboard")?"active":"")" asp-page="/Admin/Dashboard/Index">
                    <!-- SVG: dashboard icon -->
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="3" y="3" width="8" height="8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/><rect x="13" y="3" width="8" height="5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/><rect x="13" y="10" width="8" height="11" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    Dashboard
                </a>
                <a class="nav-item @(Context.Request.Path.StartsWithSegments("/Admin/Companies")?"active":"")" asp-page="/Admin/Companies/Index">
                    <!-- SVG: building icon -->
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M3 21h18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M5 21V7a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M9 10h.01M13 10h.01M17 10h.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    Companies
                </a>
                <a class="nav-item @(Context.Request.Path.StartsWithSegments("/Admin/Users")?"active":"")" asp-page="/Admin/Users/Index">
                    <!-- SVG: users icon -->
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="7" r="4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    Users
                </a>
                <a class="nav-item @(Context.Request.Path.StartsWithSegments("/Admin/Settings")?"active":"")" asp-page="/Admin/Settings/Index">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 15.5A3.5 3.5 0 1 0 12 8.5a3.5 3.5 0 0 0 0 7z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06A2 2 0 0 1 2.28 17.1l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82L4.3 3.28a2 2 0 0 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H11a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09c0 .58.37 1.11 1 1.51h.09a1.65 1.65 0 0 0 1.51 1 1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33H13a1.65 1.65 0 0 0-1 1.51V11a1.65 1.65 0 0 0 1 1.51h.09c.71.15 1.36.6 1.82 1.21z" stroke="currentColor" stroke-width="0.9" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    Settings
                </a>
            </nav>
            <div class="footer">v1 • POS</div>
        </aside>

        <main class="main-area">
            <header class="topbar">
                <div class="left">
                    <button class="btn-ghost" id="sidebarToggle">Menu</button>
                </div>
                <div class="search">
                    <input type="search" placeholder="Search companies, products, orders..." aria-label="Search" />
                </div>
                <div class="top-actions">
                    <a class="btn-ghost" asp-page="/Admin/Companies/Create">New Company</a>
                    <button id="themeToggle" class="theme-toggle" aria-pressed="false" title="Toggle theme" aria-label="Toggle theme">
                        <!-- default icon replaced by JS on load -->
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.2"/></svg>
                    </button>
                    <div class="user-menu small text-muted">Admin</div>
                </div>
            </header>

            <section class="content-wrap container-main">
                @if (TempData["Success"] != null)
                {
                    <div class="card" role="status" style="border-left:4px solid var(--accent); padding:0.85rem; margin-bottom:1rem;">
                        <div class="small">@TempData["Success"]</div>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="card" role="alert" style="border-left:4px solid #D66; padding:0.85rem; margin-bottom:1rem;">
                        <div class="small">@TempData["Error"]</div>
                    </div>
                }

                @RenderBody()
            </section>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Sidebar toggle for small screens
        document.getElementById('sidebarToggle')?.addEventListener('click', function(){
            const sb = document.querySelector('.sidebar');
            if(!sb) return;
            sb.style.display = (sb.style.display === 'none' ? 'flex' : 'none');
        });

        // Theme toggle: persists preference in localStorage ("admin_theme" = "dark" or "light")
        (function(){
            const key = 'admin_theme';
            const root = document.documentElement;
            const btn = document.getElementById('themeToggle');
            const icons = {
                sun: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M12 4V2M12 22v-2M4.93 4.93L3.51 3.51M20.49 20.49l-1.42-1.42M4 12H2M22 12h-2M4.93 19.07l-1.42 1.42M20.49 3.51l-1.42 1.42" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.4"/></svg>',
                moon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>'
            };

            function applyTheme(theme, save){
                if(theme === 'dark'){
                    root.classList.add('theme-dark');
                    btn.innerHTML = icons.sun; // show sun to switch back to light
                    btn.setAttribute('aria-pressed','true');
                } else {
                    root.classList.remove('theme-dark');
                    btn.innerHTML = icons.moon; // show moon to switch to dark
                    btn.setAttribute('aria-pressed','false');
                }
                if(save) localStorage.setItem(key, theme);
            }

            // initialize
            try{
                const saved = localStorage.getItem(key);
                if(saved === 'dark' || saved === 'light'){
                    applyTheme(saved, false);
                } else {
                    // default to system preference
                    const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
                    applyTheme(prefersDark ? 'dark' : 'light', false);
                }
            } catch(e){
                // fallback: system only
                const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
                applyTheme(prefersDark ? 'dark' : 'light', false);
            }

            btn?.addEventListener('click', function(){
                const isDark = root.classList.contains('theme-dark');
                applyTheme(isDark ? 'light' : 'dark', true);
            });
        })();
    </script>
</body>
</html>
