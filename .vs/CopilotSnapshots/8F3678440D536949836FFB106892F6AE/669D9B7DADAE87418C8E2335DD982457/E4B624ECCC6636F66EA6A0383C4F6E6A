<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - POS Admin</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/theme.css" />
</head>
<body>
    <div class="admin-shell">
        <aside class="sidebar">
            <div class="brand">POS Admin</div>
            <nav class="nav-vertical" aria-label="Main navigation">
                <a class="nav-item @(Context.Request.Path.StartsWithSegments("/Admin/Companies")?"active":"")" asp-page="/Admin/Companies/Index">
                    <!-- SVG: building icon -->
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M3 21h18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M5 21V7a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M9 10h.01M13 10h.01M17 10h.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    Companies
                </a>
                <a class="nav-item @(Context.Request.Path.StartsWithSegments("/Admin/Products")?"active":"")" asp-page="/Admin/Products/Index">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    Products
                </a>
                <a class="nav-item @(Context.Request.Path.StartsWithSegments("/Admin/Orders")?"active":"")" asp-page="/Admin/Orders/Index">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M3 3h18v4H3zM7 21h10a1 1 0 0 0 1-.78L19 7H5L4 20.22A1 1 0 0 0 5 21z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    Orders
                </a>
                <a class="nav-item @(Context.Request.Path.StartsWithSegments("/Admin/Settings")?"active":"")" asp-page="/Admin/Settings/Index">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 15.5A3.5 3.5 0 1 0 12 8.5a3.5 3.5 0 0 0 0 7z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06A2 2 0 0 1 2.28 17.1l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82L4.3 3.28a2 2 0 0 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H11a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09c0 .58.37 1.11 1 1.51h.09a1.65 1.65 0 0 0 1.51 1 1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33H13a1.65 1.65 0 0 0-1 1.51V11a1.65 1.65 0 0 0 1 1.51h.09c.71.15 1.36.6 1.82 1.21z" stroke="currentColor" stroke-width="0.9" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    Settings
                </a>
            </nav>
            <div class="footer">v1 • POS</div>
        </aside>

        <main class="main-area">
            <header class="topbar">
                <div class="left">
                    <button class="btn-ghost" id="sidebarToggle">Menu</button>
                </div>
                <div class="search">
                    <input type="search" placeholder="Search companies, products, orders..." aria-label="Search" />
                </div>
                <div class="top-actions">
                    <a class="btn-ghost" asp-page="/Admin/Companies/Create">New Company</a>
                    <div class="user-menu small text-muted">Admin</div>
                </div>
            </header>

            <section class="content-wrap container-main">
                @if (TempData["Success"] != null)
                {
                    <div class="card" role="status" style="border-left:4px solid var(--accent); padding:0.85rem; margin-bottom:1rem;">
                        <div class="small">@TempData["Success"]</div>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="card" role="alert" style="border-left:4px solid #D66; padding:0.85rem; margin-bottom:1rem;">
                        <div class="small">@TempData["Error"]</div>
                    </div>
                }

                @RenderBody()
            </section>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Sidebar toggle for small screens
        document.getElementById('sidebarToggle')?.addEventListener('click', function(){
            const sb = document.querySelector('.sidebar');
            if(!sb) return;
            sb.style.display = (sb.style.display === 'none' ? 'flex' : 'none');
        });
    </script>
</body>
</html>
