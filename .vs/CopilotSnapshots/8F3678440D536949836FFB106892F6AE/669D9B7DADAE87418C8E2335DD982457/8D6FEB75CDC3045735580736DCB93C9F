@page "{id:int}"
@model Api.Pages.Admin.Companies.DetailsModel
@{
    ViewData["Title"] = Model.Company?.Name ?? "Company";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="mb-0">@Model.Company?.Name <span class="small text-muted">#@Model.Company?.Id</span></h3>
        <div class="small text-muted">Company details and user management</div>
    </div>
    <div>
        <a class="btn-ghost" asp-page="Edit" asp-route-id="@Model.Company?.Id">Edit company</a>
        <a class="btn-ghost" asp-page="Index">Back</a>
    </div>
</div>

<div class="card mb-4">
    <div style="display:grid; grid-template-columns: repeat(3,1fr); gap:1rem; padding:1rem">
        <div class="small text-muted">Country</div>
        <div class="small text-muted">Email</div>
        <div class="small text-muted">Phone</div>
        <div><strong>@Model.Company?.CountryName (@Model.Company?.CountryId)</strong></div>
        <div><strong>@Model.Company?.Email</strong></div>
        <div><strong>@Model.Company?.PhoneNumber</strong></div>
        <div class="small text-muted">City</div>
        <div class="small text-muted">Tax #</div>
        <div></div>
        <div><strong>@Model.Company?.City</strong></div>
        <div><strong>@Model.Company?.TaxNumber</strong></div>
    </div>
</div>

<div class="card mb-4">
    <div style="padding:1rem; border-bottom:1px solid var(--border);" class="d-flex justify-content-between align-items-center">
        <div class="small text-muted">Subscription & devices</div>
    </div>
    <div style="padding:1rem">
        @if (!Model.HasTenant)
        {
            <div class="text-muted">No control-plane tenant for this company yet (not provisioned).</div>
        }
        else
        {
            <div style="display:grid; grid-template-columns: repeat(4,1fr); gap:1rem; align-items:center;">
                <div>
                    <div class="small text-muted">Status</div>
                    <div class="fw-bold">@Model.BillingStatus</div>
                </div>
                <div>
                    <div class="small text-muted">Days left</div>
                    @if (Model.SubscriptionDaysLeft == null)
                    {
                        <div class="fs-5">—</div>
                    }
                    else
                    {
                        var dl = Model.SubscriptionDaysLeft.Value;
                        var cls = dl <= 0 ? "text-danger" : (dl <= 7 ? "text-warning" : "text-success");
                        <div class="fs-4 fw-bold @cls">@dl <span class="small text-muted">day(s)</span></div>
                    }
                </div>
                <div>
                    <div class="small text-muted">Expires</div>
                    <div>@(Model.SubscriptionEnd?.ToUniversalTime().ToString("yyyy-MM-dd") ?? "—")</div>
                </div>
                <div>
                    <div class="small text-muted">Devices</div>
                    @{ var over = Model.RegisteredDevices > Model.SeatAllowance; }
                    <div class="fs-4 fw-bold @(over ? "text-danger" : "")">@Model.RegisteredDevices <span class="small text-muted">/ @Model.SeatAllowance</span></div>
                </div>
            </div>
        }
    </div>
</div>

<div class="card mb-4">
    <div style="display:flex; justify-content:space-between; align-items:center; padding:1rem; border-bottom:1px solid var(--border)">
        <div class="small text-muted">Security — clone / duplication audit <span class="small text-muted">(Pillar 5)</span></div>
        @if (Model.CloneAlertCount > 0)
        {
            <div class="small text-danger">@Model.CloneAlertCount alert(s)</div>
        }
        else
        {
            <div class="small text-success">No alerts</div>
        }
    </div>
    <div style="padding:1rem">
        @if (Model.CloneAlertCount == 0)
        {
            <div class="text-muted">No duplicated transactions detected. Every synced sale was reported by a single device.</div>
        }
        else
        {
            <p class="text-danger mb-2">The same transaction id was synced from more than one device — a sign a terminal's local data was duplicated onto another device (clone / restored backup).</p>
            <table class="table-clean" aria-describedby="clone-alerts">
                <thead>
                    <tr>
                        <th>Transaction id</th>
                        <th>Origin device</th>
                        <th>Duplicate device</th>
                        <th>Times seen</th>
                        <th>Last seen (UTC)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.CloneAlerts)
                    {
                        <tr>
                            <td><code>@a.ClientTxnId</code></td>
                            <td><code>@a.FirstDeviceId</code></td>
                            <td><code class="text-danger">@a.LastDeviceId</code></td>
                            <td>@a.SeenCount</td>
                            <td>@a.LastSeenUtc.ToString("yyyy-MM-dd HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<h4 class="mb-3">Users <span class="small text-muted">— @Model.Users.Count</span></h4>

<table class="table-clean" aria-describedby="users-table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Username</th>
            <th>Name</th>
            <th>Email</th>
            <th>Access</th>
            <th>Enabled</th>
            <th style="width: 360px;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var u in Model.Users)
        {
            <tr>
                <td class="small text-muted">@u.Id</td>
                <td><strong>@u.Username</strong></td>
                <td>@u.FirstName @u.LastName</td>
                <td class="small text-muted">@u.Email</td>
                <td>@u.AccessLevel</td>
                <td>
                    @if (u.IsEnabled)
                    {
                        <div class="small text-success">Yes</div>
                    }
                    else
                    {
                        <div class="small text-muted">No</div>
                    }
                </td>
                <td>
                    <div style="display:flex; gap:0.5rem; align-items:center">
                        <a class="btn-ghost" asp-page="/Admin/Users/Edit" asp-route-id="@Model.Company?.Id" asp-route-userId="@u.Id">Edit</a>

                        <form method="post" asp-page-handler="ResetPassword" asp-route-id="@Model.Company?.Id" style="display:flex; gap:0.5rem; align-items:center">
                            <input type="hidden" name="userId" value="@u.Id" />
                            <input type="password" name="newPassword" class="form-control form-control-sm" placeholder="New password" style="width: 130px;" required />
                            <button type="submit" class="btn-ghost" style="border-color:rgba(255,165,0,0.12); color:#B55F00">Reset</button>
                        </form>

                        <form method="post" asp-page-handler="DeleteUser" asp-route-id="@Model.Company?.Id" onsubmit="return confirm('Delete user @u.Username?');">
                            <input type="hidden" name="userId" value="@u.Id" />
                            <button type="submit" class="btn-ghost" style="color:#B45252; border-color:rgba(180,82,82,0.12);">Delete</button>
                        </form>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="card mt-4">
    <div style="padding:1rem; border-bottom:1px solid var(--border);"><strong>Add user</strong></div>
    <div style="padding:1rem">
        <form method="post" asp-page-handler="AddUser" asp-route-id="@Model.Company?.Id">
            <div style="display:grid; grid-template-columns: repeat(6,1fr); gap:0.5rem;">
                <div class="form-field" style="grid-column: span 2;">
                    <label>Username *</label>
                    <input asp-for="NewUser.Username" required />
                </div>
                <div class="form-field" style="grid-column: span 2;">
                    <label>Password *</label>
                    <input type="password" asp-for="NewUser.Password" required />
                </div>
                <div class="form-field">
                    <label>Access level</label>
                    <input type="number" asp-for="NewUser.AccessLevel" />
                </div>
                <div class="form-field">
                    <label>First name</label>
                    <input asp-for="NewUser.FirstName" />
                </div>
                <div class="form-field">
                    <label>Last name</label>
                    <input asp-for="NewUser.LastName" />
                </div>
                <div class="form-field">
                    <label>Email</label>
                    <input asp-for="NewUser.Email" />
                </div>
            </div>
            <div style="margin-top:0.75rem">
                <button type="submit" class="btn-primary">Add user</button>
            </div>
        </form>
    </div>
</div>
