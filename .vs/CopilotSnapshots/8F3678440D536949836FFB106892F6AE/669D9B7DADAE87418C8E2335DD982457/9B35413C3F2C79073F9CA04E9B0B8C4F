@page
@model Api.Pages.Admin.Companies.CreateModel
@{
    ViewData["Title"] = "New company";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="mb-0">New company</h3>
    <a class="btn-ghost" asp-page="Index">Back</a>
</div>

<form method="post" class="card">
    <div style="display:grid; grid-template-columns: repeat(2, 1fr); gap:1rem; padding:1rem">
        <div class="form-field">
            <label>Name *</label>
            <input asp-for="Input.Name" required />
        </div>
        <div class="form-field">
            <label>Country *</label>
            @if (Model.Countries.Count > 0)
            {
                <select asp-for="Input.CountryId">
                    @foreach (var c in Model.Countries)
                    {
                        <option value="@c.Id">@c.Name (@c.Id)</option>
                    }
                </select>
            }
            else
            {
                <input type="number" asp-for="Input.CountryId" />
                <div class="small text-muted">No countries found — enter an existing CountryId.</div>
            }
        </div>
        <div class="form-field">
            <label>Email</label>
            <input asp-for="Input.Email" />
        </div>
        <div class="form-field">
            <label>Phone</label>
            <input asp-for="Input.PhoneNumber" />
        </div>
        <div class="form-field">
            <label>Address</label>
            <input asp-for="Input.Address" />
        </div>
        <div class="form-field">
            <label>City</label>
            <input asp-for="Input.City" />
        </div>
        <div class="form-field">
            <label>Postal code</label>
            <input asp-for="Input.PostalCode" />
        </div>
        <div class="form-field">
            <label>Tax number</label>
            <input asp-for="Input.TaxNumber" />
        </div>
    </div>

    <div style="padding:1rem; border-top:1px solid var(--border)">
        <h6 class="text-muted">Subscription</h6>
        <div style="display:grid; grid-template-columns: repeat(3,1fr); gap:1rem; margin-top:0.5rem">
            <div class="form-field">
                <label>Period</label>
                <select asp-for="Input.SubscriptionDays">
                    <option value="14">14 days (trial)</option>
                    <option value="30" selected>1 month (30 days)</option>
                    <option value="90">3 months (90 days)</option>
                    <option value="180">6 months (180 days)</option>
                    <option value="365">1 year (365 days)</option>
                </select>
            </div>
            <div class="form-field">
                <label>Seats (terminals)</label>
                <input type="number" min="1" asp-for="Input.SeatAllowance" />
            </div>
        </div>
    </div>

    <div style="padding:1rem; border-top:1px solid var(--border)">
        <div class="form-field">
            <label><input type="checkbox" asp-for="Input.CreateFirstUser" /> Also create the first admin user</label>
        </div>

        <div style="display:grid; grid-template-columns: repeat(3,1fr); gap:1rem">
            <div class="form-field">
                <label>Username</label>
                <input asp-for="Input.Username" />
            </div>
            <div class="form-field">
                <label>Password</label>
                <input type="password" asp-for="Input.Password" />
            </div>
            <div class="form-field">
                <label>Access level</label>
                <input type="number" asp-for="Input.AccessLevel" />
            </div>
            <div class="form-field">
                <label>First name</label>
                <input asp-for="Input.FirstName" />
            </div>
            <div class="form-field">
                <label>Last name</label>
                <input asp-for="Input.LastName" />
            </div>
            <div class="form-field">
                <label>User email</label>
                <input asp-for="Input.UserEmail" />
            </div>
        </div>

        <div style="margin-top:1rem">
            <button type="submit" class="btn-primary">Create company</button>
        </div>
    </div>
</form>
