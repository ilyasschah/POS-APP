/* Premium Minimalist Theme - Light & Dark variants
   - Light: white background, soft off-white surfaces
   - Dark: deep muted grays
   - Typography: Inter (fallback system sans)
   - Minimal accent: steel slate blue
*/
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

:root{
  --bg: #ffffff;
  --surface: #F8F9FA;
  --muted-surface: #F1F3F5;
  --text: #1F2937; /* dark slate */
  --muted: #6B7280;
  --accent: #6082A3; /* muted steel-blue */
  --shadow: 0 6px 18px rgba(31,41,55,0.06);
  --border: rgba(31,41,55,0.06);
  --radius: 10px;
  --card-padding: 1rem;
  --max-content-width: 1200px;
}

/* Explicit theme class to override prefers-color-scheme when user sets preference */
.theme-dark, .theme-dark * {
  --bg: #121212;
  --surface: #1E1E1E;
  --muted-surface: #171717;
  --text: #E6EEF3;
  --muted: #9CA3AF;
  --accent: #6F8BAA;
  --shadow: none;
  --border: rgba(255,255,255,0.06);
}

@media (prefers-color-scheme: dark){
  :root{
    --bg: #121212;
    --surface: #1E1E1E;
    --muted-surface: #171717;
    --text: #E6EEF3; /* soft off-white */
    --muted: #9CA3AF;
    --accent: #6F8BAA;
    --shadow: none;
    --border: rgba(255,255,255,0.06);
  }
}

/* Global */
html,body{
  height:100%;
  background:var(--bg);
  color:var(--text);
  font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial;
  -webkit-font-smoothing:antialiased;
  -moz-osx-font-smoothing:grayscale;
  margin:0;
  transition: background-color 200ms ease, color 200ms ease;
}

.container-main{
  max-width:var(--max-content-width);
  margin:0 auto;
  padding:1.5rem;
}

/* Admin Layout */
.admin-shell{
  display:flex;
  min-height:100vh;
}

.sidebar{
  width:270px;
  background:var(--surface);
  border-right:1px solid var(--border);
  padding:1.25rem;
  box-shadow: var(--shadow);
  display:flex;
  flex-direction:column;
  gap:1rem;
}

.brand{
  font-weight:600;
  font-size:1.05rem;
  color:var(--text);
  padding-bottom:0.35rem;
}

.nav-vertical{
  display:flex;
  flex-direction:column;
  gap:0.25rem;
  margin-top:0.5rem;
}

.nav-item{
  display:flex;
  align-items:center;
  gap:0.75rem;
  padding:0.6rem 0.7rem;
  color:var(--muted);
  border-radius:8px;
  text-decoration:none;
}

.nav-item:hover{ background:var(--muted-surface); color:var(--text); }
.nav-item.active{ background:linear-gradient(90deg, rgba(96,130,163,0.08), transparent); color:var(--accent); font-weight:600; }

.sidebar .footer{
  margin-top:auto;
  font-size:0.85rem;
  color:var(--muted);
}

.main-area{
  flex:1;
  display:flex;
  flex-direction:column;
}

.topbar{
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:1rem 1.25rem;
  border-bottom:1px solid var(--border);
  background:transparent;
}

.topbar .search{
  width:420px;
  max-width:60%;
}

.topbar .search input{
  width:100%;
  border-radius:999px;
  border:1px solid var(--border);
  padding:0.5rem 0.9rem;
  background:var(--muted-surface);
  color:var(--text);
}

.top-actions{ display:flex; align-items:center; gap:0.75rem; }

/* Theme toggle button */
.theme-toggle{
  width:40px;
  height:36px;
  display:inline-flex;
  align-items:center;
  justify-content:center;
  border-radius:8px;
  border:1px solid var(--border);
  background:var(--muted-surface);
  color:var(--text);
  cursor:pointer;
}

.content-wrap{
  padding:1.5rem;
}

/* Cards */
.kpi-grid{ display:grid; grid-template-columns: repeat(auto-fit, minmax(200px,1fr)); gap:1rem; margin-bottom:1rem; }
.card{
  background:var(--surface);
  border-radius:var(--radius);
  padding:var(--card-padding);
  box-shadow:var(--shadow);
  border:1px solid var(--border);
}
.card .title{ font-size:0.9rem; color:var(--muted); }
.card .value{ font-size:1.4rem; font-weight:600; margin-top:0.35rem; }

/* Table */
.table-clean{ width:100%; border-collapse:collapse; background:transparent; margin-top:0.5rem; }
.table-clean th, .table-clean td{ text-align:left; padding:0.9rem; border-bottom:1px solid var(--border); }
.table-clean thead th{ color:var(--muted); font-weight:600; font-size:0.85rem; }
.table-clean tbody tr:hover{ background:var(--muted-surface); }

.btn-primary{
  background:var(--accent);
  color:#fff;
  border:none;
  padding:0.55rem 0.9rem;
  border-radius:8px;
  font-weight:600;
}

.btn-ghost{
  background:transparent;
  color:var(--text);
  border:1px solid var(--border);
  padding:0.45rem 0.75rem;
  border-radius:8px;
}

/* Forms */
.form-field{ display:flex; flex-direction:column; gap:0.35rem; margin-bottom:0.85rem; }
.form-field label{ color:var(--muted); font-size:0.85rem; }
.form-field input, .form-field select, .form-field textarea{
  padding:0.6rem 0.75rem; border-radius:8px; border:1px solid var(--border); background:var(--muted-surface); color:var(--text);
}

/* Responsive */
@media (max-width:900px){
  .sidebar{ display:none; }
  .topbar .search{ display:none; }
  .container-main{ padding:1rem; }
}

/* Utility */
.text-muted{ color:var(--muted); }
.small{ font-size:0.85rem; }

/* Ensure low contrast focus outlines */
:focus{ outline:2px solid rgba(96,130,163,0.12); outline-offset:2px; }
