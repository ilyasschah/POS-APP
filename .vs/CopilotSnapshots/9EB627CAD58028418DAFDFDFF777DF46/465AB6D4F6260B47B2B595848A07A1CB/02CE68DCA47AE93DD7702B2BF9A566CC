using System.ComponentModel.DataAnnotations.Schema;

namespace Products.Api.Domain
{
    [Table("CustomerDiscount")]
    public class CustomerDiscount
    {
        public int Id { get; set; }
        public int CompanyId { get; set; }
        public int CustomerId { get; set; }
        public int Type { get; set; }
        public int Uid { get; set; }
        public decimal Value { get; set; }
        [ForeignKey("CustomerId")]
        public virtual Customer Customer { get; set; }

        private CustomerDiscount (int customerid , int type, int uid, decimal value)
        {
            CustomerId = customerid;
            Type = type;
            Uid = uid;
            Value = value;
        }
        public CustomerDiscount() { }
        public static CustomerDiscount Create(int customerid, int type, int uid, decimal value)
        {
            return new CustomerDiscount(customerid, type, uid, value);
        }
    }
}