@page "{id:int}"
@model Api.Pages.Admin.Companies.DetailsModel
@{
    ViewData["Title"] = Model.Company?.Name ?? "Company";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">@Model.Company?.Name <span class="text-muted fs-6">#@Model.Company?.Id</span></h3>
    <div>
        <a class="btn btn-outline-primary" asp-page="Edit" asp-route-id="@Model.Company?.Id">Edit company</a>
        <a class="btn btn-outline-secondary" asp-page="Index">Back to list</a>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body row">
        <div class="col-md-4"><strong>Country:</strong> @Model.Company?.CountryName (@Model.Company?.CountryId)</div>
        <div class="col-md-4"><strong>Email:</strong> @Model.Company?.Email</div>
        <div class="col-md-4"><strong>Phone:</strong> @Model.Company?.PhoneNumber</div>
        <div class="col-md-4"><strong>City:</strong> @Model.Company?.City</div>
        <div class="col-md-4"><strong>Tax #:</strong> @Model.Company?.TaxNumber</div>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header">Subscription &amp; devices</div>
    <div class="card-body">
        @if (!Model.HasTenant)
        {
            <div class="text-muted">No control-plane tenant for this company yet (not provisioned).</div>
        }
        else
        {
            <div class="row">
                <div class="col-md-3">
                    <div class="text-muted small">Status</div>
                    <span class="badge bg-info text-dark text-uppercase">@Model.BillingStatus</span>
                </div>
                <div class="col-md-3">
                    <div class="text-muted small">Days left</div>
                    @if (Model.SubscriptionDaysLeft == null)
                    {
                        <span class="fs-5">—</span>
                    }
                    else
                    {
                        var dl = Model.SubscriptionDaysLeft.Value;
                        var cls = dl <= 0 ? "text-danger" : (dl <= 7 ? "text-warning" : "text-success");
                        <span class="fs-4 fw-bold @cls">@dl</span>
                        <span class="text-muted">day(s)</span>
                    }
                </div>
                <div class="col-md-3">
                    <div class="text-muted small">Expires</div>
                    <span>@(Model.SubscriptionEnd?.ToUniversalTime().ToString("yyyy-MM-dd") ?? "—")</span>
                </div>
                <div class="col-md-3">
                    <div class="text-muted small">Devices</div>
                    @{ var over = Model.RegisteredDevices > Model.SeatAllowance; }
                    <span class="fs-4 fw-bold @(over ? "text-danger" : "text-dark")">@Model.RegisteredDevices</span>
                    <span class="text-muted">/ @Model.SeatAllowance seat(s)</span>
                </div>
            </div>
        }
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Security &mdash; clone / duplication audit <span class="text-muted small">(Pillar 5)</span></span>
        @if (Model.CloneAlertCount > 0)
        {
            <span class="badge bg-danger">@Model.CloneAlertCount alert(s)</span>
        }
        else
        {
            <span class="badge bg-success">No alerts</span>
        }
    </div>
    <div class="card-body">
        @if (Model.CloneAlertCount == 0)
        {
            <div class="text-muted">No duplicated transactions detected. Every synced sale was reported by a single device.</div>
        }
        else
        {
            <p class="text-danger mb-2">
                The same transaction id was synced from more than one device — a sign a terminal's
                local data was duplicated onto another device (clone / restored backup).
            </p>
            <table class="table table-sm align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Transaction id</th>
                        <th>Origin device</th>
                        <th>Duplicate device</th>
                        <th>Times seen</th>
                        <th>Last seen (UTC)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.CloneAlerts)
                    {
                        <tr>
                            <td><code>@a.ClientTxnId</code></td>
                            <td><code>@a.FirstDeviceId</code></td>
                            <td><code class="text-danger">@a.LastDeviceId</code></td>
                            <td>@a.SeenCount</td>
                            <td>@a.LastSeenUtc.ToString("yyyy-MM-dd HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<h4 class="mb-3">Users <span class="badge bg-secondary">@Model.Users.Count</span></h4>

<table class="table bg-white shadow-sm align-middle">
    <thead class="table-light">
        <tr>
            <th>Id</th>
            <th>Username</th>
            <th>Name</th>
            <th>Email</th>
            <th>Access</th>
            <th>Enabled</th>
            <th style="width: 360px;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var u in Model.Users)
        {
            <tr>
                <td>@u.Id</td>
                <td><strong>@u.Username</strong></td>
                <td>@u.FirstName @u.LastName</td>
                <td>@u.Email</td>
                <td>@u.AccessLevel</td>
                <td>
                    @if (u.IsEnabled)
                    {
                        <span class="badge bg-success">Yes</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">No</span>
                    }
                </td>
                <td>
                    <div class="d-flex gap-1 align-items-center">
                        <a class="btn btn-sm btn-outline-primary"
                           asp-page="/Admin/Users/Edit" asp-route-id="@Model.Company?.Id" asp-route-userId="@u.Id">Edit</a>

                        <form method="post" asp-page-handler="ResetPassword" asp-route-id="@Model.Company?.Id" class="d-flex gap-1">
                            <input type="hidden" name="userId" value="@u.Id" />
                            <input type="password" name="newPassword" class="form-control form-control-sm" placeholder="New password" style="width: 130px;" required />
                            <button type="submit" class="btn btn-sm btn-outline-warning">Reset</button>
                        </form>

                        <form method="post" asp-page-handler="DeleteUser" asp-route-id="@Model.Company?.Id"
                              onsubmit="return confirm('Delete user @u.Username?');">
                            <input type="hidden" name="userId" value="@u.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="card shadow-sm mt-4">
    <div class="card-header">Add user</div>
    <div class="card-body">
        <form method="post" asp-page-handler="AddUser" asp-route-id="@Model.Company?.Id">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Username *</label>
                    <input class="form-control" asp-for="NewUser.Username" required />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Password *</label>
                    <input type="password" class="form-control" asp-for="NewUser.Password" required />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Access level</label>
                    <input type="number" class="form-control" asp-for="NewUser.AccessLevel" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">First name</label>
                    <input class="form-control" asp-for="NewUser.FirstName" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Last name</label>
                    <input class="form-control" asp-for="NewUser.LastName" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Email</label>
                    <input class="form-control" asp-for="NewUser.Email" />
                </div>
            </div>
            <button type="submit" class="btn btn-primary mt-3">Add user</button>
        </form>
    </div>
</div>
