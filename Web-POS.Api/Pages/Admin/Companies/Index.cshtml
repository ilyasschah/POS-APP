@page
@model Api.Pages.Admin.Companies.IndexModel
@{
    ViewData["Title"] = "Companies";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Companies <span class="badge bg-secondary">@Model.Companies.Count</span></h3>
    <a class="btn btn-primary" asp-page="Create">+ New company</a>
</div>

@if (Model.Companies.Count == 0)
{
    <div class="alert alert-info">No companies yet.</div>
}
else
{
    <table class="table table-hover bg-white shadow-sm align-middle">
        <thead class="table-light">
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Country</th>
                <th>Email</th>
                <th>Phone</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model.Companies)
            {
                <tr>
                    <td>@c.Id</td>
                    <td><strong>@c.Name</strong></td>
                    <td>@c.CountryName</td>
                    <td>@c.Email</td>
                    <td>@c.PhoneNumber</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" asp-page="Details" asp-route-id="@c.Id">Details &amp; users</a>
                        <a class="btn btn-sm btn-outline-primary" asp-page="Edit" asp-route-id="@c.Id">Edit</a>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@c.Id" class="d-inline"
                              onsubmit="return confirm('Delete company &quot;@c.Name&quot; and ALL its data? This cannot be undone.');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
