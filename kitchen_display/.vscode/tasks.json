{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "KDS: Build Windows (Debug)",
      "type": "shell",
      "command": "flutter",
      "args": [
        "build",
        "windows",
        "--debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "KDS: Build Windows (Release)",
      "type": "shell",
      "command": "flutter",
      "args": [
        "build",
        "windows",
        "--release"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "KDS: Run Windows (Debug)",
      "type": "shell",
      "command": "flutter",
      "args": [
        "run",
        "-d",
        "windows",
        "--debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
