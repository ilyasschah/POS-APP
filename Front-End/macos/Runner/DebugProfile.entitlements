<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Mirrors Release.entitlements: no App Sandbox, so a debug run behaves like the
  shipped app instead of failing on entitlements that release never had.
  See Release.entitlements for why the sandbox is off.
-->
<plist version="1.0">
<dict>
	<!-- The Dart VM runs JIT in debug/profile; without this the app cannot start. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<!-- Hot reload and DevTools connect to a VM service socket the app listens on. -->
	<key>com.apple.security.network.server</key>
	<true/>
</dict>
</plist>
