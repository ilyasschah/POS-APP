@{ var isSignedIn = User.Identity?.IsAuthenticated == true;
   var onCompanies = Context.Request.Path.StartsWithSegments("/Admin/Companies");
   var onSubscriptions = Context.Request.Path.StartsWithSegments("/Admin/Subscriptions");
   var displayName = isSignedIn
       ? (User.FindFirst(Api.Admin.AdminPortalAuth.DisplayNameClaim)?.Value ?? User.Identity!.Name)
       : null; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    @*  viewport-fit=cover lets the page paint under the notch on iPhones. No
        maximum-scale, so pinch-zoom stays available. *@
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#ffffff" id="themeColorMeta" />
    <title>@ViewData["Title"] - POS Admin</title>

    @*  Theme is applied before first paint. Tabler 1.x follows Bootstrap 5.3 and
        reads data-bs-theme on <html>; deferring this to a script at the end of
        the body makes every load flash light before going dark. *@
    <script>
        (function () {
            try {
                var t = localStorage.getItem('admin_theme');
                if (t !== 'dark' && t !== 'light') {
                    t = (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : 'light';
                }
                document.documentElement.setAttribute('data-bs-theme', t);
            } catch (e) { document.documentElement.setAttribute('data-bs-theme', 'light'); }
        })();
    </script>

    @*  Tabler bundles its own Bootstrap build — loading a second Bootstrap CDN
        alongside it means two conflicting copies, so there is only this one. *@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/core@@1.4.0/dist/css/tabler.min.css" />
    <link rel="stylesheet" href="~/css/theme.css" />

    @*  Shared with the Flutter client (Front-End/assets) so the portal, the app
        and the installer all carry the same mark. *@
    <link rel="icon" type="image/svg+xml" href="~/img/icon.svg" />
    <link rel="icon" href="~/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="~/img/icon.png" />
</head>
<body>
    <div class="page">

        @*  navbar-expand-lg, not -md: brand + two sections + New Company + theme +
            username + Sign out do not fit a 820px tablet, where they overflowed and
            clipped "Sign out" off the edge. Below 992px the whole lot collapses
            behind the hamburger and the header keeps only the brand and the toggle.
            Signed-out pages (the login form) render the shell without navigation
            or account actions — every one of those destinations would just
            bounce back to the login page. *@
        <header class="navbar navbar-expand-lg d-print-none sticky-top">
            <div class="container-xl">

                @if (isSignedIn)
                {
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                            data-bs-target="#navbar-menu" aria-controls="navbar-menu"
                            aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                }

                @*  me-auto: Bootstrap sets justify-content:space-between on the
                    navbar container, so with only the burger and the brand visible
                    on a phone the two would be flung to opposite edges. On desktop
                    the collapse's flex-grow absorbs the free space first, so this
                    has no effect there. *@
                <div class="navbar-brand navbar-brand-autodark pe-0 pe-lg-3 me-auto">
                    @if (isSignedIn)
                    {
                        <a class="d-flex align-items-center gap-2 text-reset text-decoration-none" asp-page="/Admin/Companies/Index">
                            <img class="brand-logo" src="~/img/icon.svg" alt="" width="32" height="32" />
                            <span>POS Admin</span>
                        </a>
                    }
                    else
                    {
                        <span class="d-flex align-items-center gap-2">
                            <img class="brand-logo" src="~/img/icon.svg" alt="" width="32" height="32" />
                            <span>POS Admin</span>
                        </span>
                    }
                </div>

                @if (isSignedIn)
                {
                    @*  Both the section links and the account actions live inside
                        the collapse, so nothing but the brand and the burger shows
                        on a phone. From lg up the collapse is display:flex, so the
                        same markup lays out as a normal horizontal navbar — no
                        duplicated buttons for the two widths. *@
                    <div class="collapse navbar-collapse" id="navbar-menu">
                        <ul class="navbar-nav">
                            <li class="nav-item @(onCompanies ? "active" : "")">
                                <a class="nav-link" asp-page="/Admin/Companies/Index">
                                    <span class="nav-link-icon">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21h18" /><path d="M5 21V7a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v14" /><path d="M9 10h.01M13 10h.01M17 10h.01" /></svg>
                                    </span>
                                    <span class="nav-link-title">Companies</span>
                                </a>
                            </li>
                            <li class="nav-item @(onSubscriptions ? "active" : "")">
                                <a class="nav-link" asp-page="/Admin/Subscriptions/Index">
                                    <span class="nav-link-icon">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="2" /><path d="M2 10h20" /><path d="M6 15h4" /></svg>
                                    </span>
                                    <span class="nav-link-title">Subscriptions</span>
                                </a>
                            </li>
                        </ul>

                        <div class="ms-lg-auto mt-3 mt-lg-0 d-flex flex-column flex-lg-row align-items-stretch align-items-lg-center gap-2">
                            <div class="d-grid d-lg-block">
                                <a class="btn btn-primary" asp-page="/Admin/Companies/Create">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
                                    New Company
                                </a>
                            </div>

                            <div class="d-flex align-items-center gap-2">
                                @*  Tabler's own theme-switch pattern: two controls, each
                                    hidden by the theme it would switch away from. *@
                                <button type="button" class="btn btn-icon hide-theme-dark" data-set-theme="dark" title="Enable dark mode" aria-label="Enable dark mode">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3c.132 0 .263 0 .393 0a7.5 7.5 0 0 0 7.92 12.446a9 9 0 1 1 -8.313 -12.454z" /></svg>
                                </button>
                                <button type="button" class="btn btn-icon hide-theme-light" data-set-theme="light" title="Enable light mode" aria-label="Enable light mode">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 12m-4 0a4 4 0 1 0 8 0a4 4 0 1 0 -8 0" /><path d="M3 12h1m8 -9v1m8 8h1m-9 8v1m-6.4 -15.4l.7 .7m12.1 -.7l-.7 .7m0 11.4l.7 .7m-12.1 -.7l-.7 .7" /></svg>
                                </button>

                                <a class="btn btn-ghost-secondary flex-fill text-truncate" asp-page="/Admin/Account/Password" title="Change password">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 12m-4 0a4 4 0 1 0 8 0a4 4 0 1 0 -8 0" /><path d="M6 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2" /></svg>
                                    <span class="text-truncate">@displayName</span>
                                </a>

                                @* POST, not a link: a GET sign-out can be fired by any
                                   <img> on any page the operator happens to open. *@
                                <form method="post" asp-page="/Admin/Logout" class="m-0">
                                    <button type="submit" class="btn btn-ghost-danger w-100">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 8v-2a2 2 0 0 0 -2 -2h-7a2 2 0 0 0 -2 2v12a2 2 0 0 0 2 2h7a2 2 0 0 0 2 -2v-2" /><path d="M9 12h12l-3 -3" /><path d="M18 15l3 -3" /></svg>
                                        Sign out
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    @* Signed out there is no menu, so the theme toggle stays in the
                       header at every width. *@
                    <div class="ms-auto d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-icon hide-theme-dark" data-set-theme="dark" title="Enable dark mode" aria-label="Enable dark mode">
                            <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3c.132 0 .263 0 .393 0a7.5 7.5 0 0 0 7.92 12.446a9 9 0 1 1 -8.313 -12.454z" /></svg>
                        </button>
                        <button type="button" class="btn btn-icon hide-theme-light" data-set-theme="light" title="Enable light mode" aria-label="Enable light mode">
                            <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 12m-4 0a4 4 0 1 0 8 0a4 4 0 1 0 -8 0" /><path d="M3 12h1m8 -9v1m8 8h1m-9 8v1m-6.4 -15.4l.7 .7m12.1 -.7l-.7 .7m0 11.4l.7 .7m-12.1 -.7l-.7 .7" /></svg>
                        </button>
                    </div>
                }
            </div>
        </header>

        <div class="page-wrapper">

            @{
                var mustChangePassword = isSignedIn
                    && User.FindFirst(Api.Admin.AdminPortalAuth.MustChangePasswordClaim)?.Value == "true";
                var hasNotice = mustChangePassword
                    || TempData["Success"] != null || TempData["Warning"] != null || TempData["Error"] != null;
            }
            @if (hasNotice)
            {
                <div class="container-xl mt-3">
                    @* Standing warning while the seeded account still carries the
                       password published in the source. Deliberately a banner and not a
                       forced redirect — locking the operator out of the portal until
                       they change it would also lock them out of every other repair. *@
                    @if (mustChangePassword)
                    {
                        <div class="alert alert-warning" role="alert">
                            This account still uses the default password that ships with the software.
                            <a class="alert-link" asp-page="/Admin/Account/Password">Change it now</a>.
                        </div>
                    }
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success" role="status">@TempData["Success"]</div>
                    }
                    @* Partial success — the action mostly worked but left something
                       behind (e.g. a company deleted while its Master-DB licensing
                       tenant survived). Distinct from Error so the operator is not
                       told to retry an action that has already committed. *@
                    @if (TempData["Warning"] != null)
                    {
                        <div class="alert alert-warning" role="alert">@TempData["Warning"]</div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
                    }
                </div>
            }

            @RenderBody()
        </div>
    </div>

    @* Tabler's bundle includes Bootstrap's JS, so collapse/dropdown/modal all
       work from this one file. *@
    <script src="https://cdn.jsdelivr.net/npm/@@tabler/core@@1.4.0/dist/js/tabler.min.js"></script>
    <script>
        // Theme switch. The attribute is already on <html> from the head script —
        // this only handles clicks and keeps the browser chrome in step.
        (function () {
            const root = document.documentElement;
            const meta = document.getElementById('themeColorMeta');

            function apply(theme, save) {
                root.setAttribute('data-bs-theme', theme);
                if (meta) meta.setAttribute('content', theme === 'dark' ? '#182433' : '#ffffff');
                if (save) { try { localStorage.setItem('admin_theme', theme); } catch (e) { } }
            }

            apply(root.getAttribute('data-bs-theme') === 'dark' ? 'dark' : 'light', false);

            document.addEventListener('click', function (e) {
                const btn = e.target.closest('[data-set-theme]');
                if (btn) apply(btn.dataset.setTheme, true);
            });
        })();

        // Seats / days steppers. Delegated, so it covers every row without wiring
        // up a listener per subscription.
        (function () {
            document.addEventListener('click', function (e) {
                const btn = e.target.closest('[data-step]');
                if (!btn) return;
                const input = btn.closest('.input-group')?.querySelector('input[type="number"]');
                if (!input) return;

                const step = Number(btn.dataset.step) || 1;
                const min = input.min === '' ? -Infinity : Number(input.min);
                const max = input.max === '' ? Infinity : Number(input.max);
                const current = Number(input.value);
                const base = isNaN(current) ? (min === -Infinity ? 0 : min) : current;

                input.value = String(Math.min(max, Math.max(min, base + step)));
                // Let anything listening for edits (validation, dirty tracking) see it.
                input.dispatchEvent(new Event('change', { bubbles: true }));
            });
        })();

        // Horizontal-scroll cue for tables wide enough to scroll inside their card.
        (function () {
            document.querySelectorAll('.table-scroll-hint').forEach(function (wrap) {
                const scroller = wrap.querySelector('.table-responsive');
                if (!scroller) return;

                function update() {
                    const max = scroller.scrollWidth - scroller.clientWidth;
                    const scrollable = max > 1;
                    wrap.classList.toggle('can-scroll-right', scrollable && scroller.scrollLeft < max - 1);
                    wrap.classList.toggle('can-scroll-left', scrollable && scroller.scrollLeft > 1);
                }

                scroller.addEventListener('scroll', update, { passive: true });
                // Catches the web-font swap and the stacked-card breakpoint, both of
                // which change scrollWidth after the first measurement.
                if (window.ResizeObserver) {
                    const ro = new ResizeObserver(update);
                    ro.observe(scroller);
                    if (scroller.firstElementChild) ro.observe(scroller.firstElementChild);
                } else {
                    window.addEventListener('resize', update);
                }
                update();
            });
        })();
    </script>
</body>
</html>
