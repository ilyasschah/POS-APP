<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - POS Admin</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/theme.css" />
</head>
<body>
    <div class="admin-shell">

        <!-- Sidebar removed — navigation now lives in the horizontal top bar. -->
        <main class="main-area">
            @*  Signed-out pages (the login form) render the shell without navigation
                or account actions — every one of those destinations would just
                bounce back to the login page. *@
            @{ var isSignedIn = User.Identity?.IsAuthenticated == true; }
            <header class="topbar">
                <div class="topbar-left">
                    <div class="brand">POS Admin</div>
                    @if (isSignedIn)
                    {
                    <nav class="nav-horizontal" aria-label="Main navigation">
                        <a class="nav-item @(Context.Request.Path.StartsWithSegments("/Admin/Companies")?"active":"")" asp-page="/Admin/Companies/Index">
                            <!-- SVG: building icon -->
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M3 21h18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M5 21V7a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M9 10h.01M13 10h.01M17 10h.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            Companies
                        </a>
                        <a class="nav-item @(Context.Request.Path.StartsWithSegments("/Admin/Subscriptions")?"active":"")" asp-page="/Admin/Subscriptions/Index">
                            <!-- SVG: card / billing icon -->
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M2 10h20" stroke="currentColor" stroke-width="1.5"/><path d="M6 15h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                            Subscriptions
                        </a>
                    </nav>
                    }
                </div>

                <div class="top-actions">
                    @if (isSignedIn)
                    {
                        <a class="btn-ghost" asp-page="/Admin/Companies/Create">New Company</a>
                    }
                    <button id="themeToggle" class="theme-toggle" aria-pressed="false" title="Toggle theme" aria-label="Toggle theme">
                        <!-- default icon replaced by JS on load -->
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.2" /></svg>
                    </button>
                    @if (isSignedIn)
                    {
                        <a class="user-menu small text-muted" asp-page="/Admin/Account/Password" title="Change password">
                            @(User.FindFirst(Api.Admin.AdminPortalAuth.DisplayNameClaim)?.Value ?? User.Identity!.Name)
                        </a>
                        @* POST, not a link: a GET sign-out can be fired by any
                           <img> on any page the operator happens to open. *@
                        <form method="post" asp-page="/Admin/Logout" style="display:inline;">
                            <button type="submit" class="btn-ghost">Sign out</button>
                        </form>
                    }
                </div>
            </header>

            <section class="content-wrap container-main">
                @* Standing warning while the seeded account still carries the
                   password published in the source. Deliberately a banner and not a
                   forced redirect — locking the operator out of the portal until
                   they change it would also lock them out of every other repair. *@
                @if (isSignedIn && User.FindFirst(Api.Admin.AdminPortalAuth.MustChangePasswordClaim)?.Value == "true")
                {
                    <div class="card" role="alert" style="border-left:4px solid #E0A400; padding:0.85rem; margin-bottom:1rem;">
                        <div class="small">
                            This account still uses the default password that ships with the software.
                            <a asp-page="/Admin/Account/Password">Change it now</a>.
                        </div>
                    </div>
                }

                @if (TempData["Success"] != null)
                {
                    <div class="card" role="status" style="border-left:4px solid var(--accent); padding:0.85rem; margin-bottom:1rem;">
                        <div class="small">@TempData["Success"]</div>
                    </div>
                }
                @* Partial success — the action mostly worked but left something
                   behind (e.g. a company deleted while its Master-DB licensing
                   tenant survived). Distinct from Error so the operator is not
                   told to retry an action that has already committed. *@
                @if (TempData["Warning"] != null)
                {
                    <div class="card" role="alert" style="border-left:4px solid #E0A400; padding:0.85rem; margin-bottom:1rem;">
                        <div class="small">@TempData["Warning"]</div>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="card" role="alert" style="border-left:4px solid #D66; padding:0.85rem; margin-bottom:1rem;">
                        <div class="small">@TempData["Error"]</div>
                    </div>
                }

                @RenderBody()
            </section>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // SIDEBAR TOGGLE JS REMOVED

        // Theme toggle: persists preference in localStorage ("admin_theme" = "dark" or "light")
        (function(){
        const key = 'admin_theme';
        const root = document.documentElement;
        const btn = document.getElementById('themeToggle');
        const icons = {
        sun: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M12 4V2M12 22v-2M4.93 4.93L3.51 3.51M20.49 20.49l-1.42-1.42M4 12H2M22 12h-2M4.93 19.07l-1.42 1.42M20.49 3.51l-1.42 1.42" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.4"/></svg>',
        moon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>'
        };

        function applyTheme(theme, save){
        if(theme === 'dark'){
        root.classList.add('theme-dark');
        root.classList.remove('theme-light');
        btn.innerHTML = icons.sun; // show sun to switch back to light
        btn.setAttribute('aria-pressed','true');
        } else {
        root.classList.add('theme-light');
        root.classList.remove('theme-dark');
        btn.innerHTML = icons.moon; // show moon to switch to dark
        btn.setAttribute('aria-pressed','false');
        }
        if(save) localStorage.setItem(key, theme);
        }

        // initialize
        try{
        const saved = localStorage.getItem(key);
        if(saved === 'dark' || saved === 'light'){
        applyTheme(saved, false);
        } else {
        // default to system preference
        const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        applyTheme(prefersDark ? 'dark' : 'light', false);
        }
        } catch(e){
        // fallback: system only
        const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        applyTheme(prefersDark ? 'dark' : 'light', false);
        }

        btn?.addEventListener('click', function(){
        const isDark = root.classList.contains('theme-dark');
        applyTheme(isDark ? 'light' : 'dark', true);
        });
        })();
    </script>
</body>
</html>