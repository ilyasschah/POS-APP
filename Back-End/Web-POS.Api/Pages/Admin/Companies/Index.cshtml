@page
@model Api.Pages.Admin.Companies.IndexModel
@{
    ViewData["Title"] = "Companies Dashboard";
}

<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row g-2 align-items-center">
            <div class="col">
                <div class="page-pretitle">Overview</div>
                <h2 class="page-title">Organizations</h2>
                <div class="text-secondary mt-1">Manage companies, subscriptions, and billing status</div>
            </div>
            @*  col-12 col-md-auto: the button sits beside the title on desktop and
                drops to its own full-width row on a phone. *@
            <div class="col-12 col-md-auto ms-md-auto d-print-none">
                <div class="btn-list d-grid d-md-block">
                    <a class="btn btn-primary" asp-page="Create">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
                        New Company
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">

        <div class="row row-cards mb-3">
            <div class="col-12 col-sm-6 col-lg-4">
                <div class="card card-sm">
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col-auto">
                                <span class="bg-primary text-white avatar">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21h18" /><path d="M5 21V7a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v14" /><path d="M9 10h.01M13 10h.01M17 10h.01" /></svg>
                                </span>
                            </div>
                            <div class="col">
                                <div class="font-weight-medium h1 mb-0">@Model.Companies.Count</div>
                                <div class="text-secondary">Total companies</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (Model.Companies.Count == 0)
        {
            <div class="card">
                <div class="empty">
                    <div class="empty-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-lg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21h18" /><path d="M5 21V7a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v14" /><path d="M9 10h.01M13 10h.01M17 10h.01" /></svg>
                    </div>
                    <p class="empty-title">No companies found</p>
                    <p class="empty-subtitle text-secondary">
                        Get started by creating your first organization and provisioning a tenant.
                    </p>
                    <div class="empty-action">
                        <a class="btn btn-primary" asp-page="Create">
                            <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
                            Create Company
                        </a>
                    </div>
                </div>
            </div>
        }
        else
        {
            @*  Two behaviours from one markup:
                  - md and up: .table-responsive scrolls sideways, and
                    .table-scroll-hint fades the edge that has more content.
                  - below md: .table-mobile-stack re-flows each row into a card,
                    taking its labels from the data-label attributes. *@
            <div class="card table-scroll-hint">
                <div class="table-responsive">
                    <table class="table table-vcenter card-table table-min table-mobile-stack">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Organization</th>
                                <th>Location</th>
                                <th>Contact Email</th>
                                <th>Phone</th>
                                <th class="w-1"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model.Companies)
                            {
                                <tr>
                                    <td class="text-secondary" data-label="ID">#@c.Id</td>
                                    <td class="cell-title">
                                        <a class="text-reset fw-bold text-decoration-none" asp-page="Details" asp-route-id="@c.Id">@c.Name</a>
                                    </td>
                                    <td data-label="Location"><span class="badge bg-secondary-lt">@c.CountryName</span></td>
                                    <td class="text-secondary break-anywhere" data-label="Email">@(string.IsNullOrEmpty(c.Email) ? "—" : c.Email)</td>
                                    <td class="text-secondary text-nowrap" data-label="Phone">@(string.IsNullOrEmpty(c.PhoneNumber) ? "—" : c.PhoneNumber)</td>
                                    <td class="cell-block" data-label="Actions">
                                        @*  flex-nowrap keeps the three on one line inside the w-1
                                            action column; theme.css lets them wrap again once the
                                            row becomes a stacked card. All three carry a border so
                                            the destructive one does not read as a stray link. *@
                                        <div class="btn-list flex-nowrap justify-content-end">
                                            <a class="btn btn-sm" asp-page="Details" asp-route-id="@c.Id">Details</a>
                                            <a class="btn btn-sm" asp-page="Edit" asp-route-id="@c.Id">Edit</a>
                                            <form method="post" asp-page-handler="Delete" asp-route-id="@c.Id" class="m-0"
                                                  onsubmit="return confirm('Delete company &quot;@c.Name&quot; and ALL its data? This cannot be undone.');">
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>
