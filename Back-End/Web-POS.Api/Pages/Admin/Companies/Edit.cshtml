@page "{id:int}"
@model Api.Pages.Admin.Companies.EditModel
@{
    ViewData["Title"] = "Edit Organization";
}

<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row g-2 align-items-center">
            <div class="col">
                <div class="page-pretitle">Organization #@Model.Input.Id</div>
                <h2 class="page-title">Edit Organization</h2>
                <div class="text-secondary mt-1">Update company profile and contact information</div>
            </div>
            <div class="col-12 col-md-auto ms-md-auto d-print-none">
                <div class="btn-list d-grid d-md-block">
                    <a class="btn btn-ghost-secondary" asp-page="Details" asp-route-id="@Model.Input.Id">Cancel &amp; Back</a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        <form method="post" class="card" enctype="multipart/form-data">
            <input type="hidden" asp-for="Input.Id" />

            <div class="card-header"><h3 class="card-title">Organization Profile</h3></div>

            <div class="card-body">
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label class="form-label required">Company Name</label>
                        <input class="form-control" asp-for="Input.Name" required placeholder="e.g., Acme Corp" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label required">Country ID</label>
                        <input type="number" class="form-control" asp-for="Input.CountryId" required placeholder="e.g., 1" />
                        <small class="form-hint">Numeric identifier for the country.</small>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label">Email Address</label>
                        <input type="email" class="form-control" asp-for="Input.Email" placeholder="billing@example.com" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label">Phone Number</label>
                        <input type="tel" class="form-control" asp-for="Input.PhoneNumber" placeholder="+1 (555) 000-0000" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label">Street Address</label>
                        <input class="form-control" asp-for="Input.Address" placeholder="123 Main St" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label">City</label>
                        <input class="form-control" asp-for="Input.City" placeholder="Metropolis" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label">Postal Code</label>
                        <input class="form-control" asp-for="Input.PostalCode" placeholder="10001" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label">Tax / VAT Number</label>
                        <input class="form-control" asp-for="Input.TaxNumber" placeholder="XX123456789" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Logo</label>
                        <div class="row g-2 align-items-center">
                            <div class="col-auto">
                                @if (Model.HasLogo)
                                {
                                    <span class="avatar avatar-md"
                                          style="background-image:url('@Url.Page("Index", "Logo", new { id = Model.Input.Id })')"></span>
                                }
                                else
                                {
                                    <span class="avatar avatar-md text-secondary">—</span>
                                }
                            </div>
                            <div class="col">
                                <input type="file" class="form-control" asp-for="Logo"
                                       accept="@Api.Admin.CompanyLogoFile.Accept" />
                                <small class="form-hint">
                                    PNG or JPEG, up to @(Api.Admin.CompanyLogoFile.MaxBytes / 1024 / 1024) MB.
                                    @if (Model.HasLogo)
                                    {
                                        <text>Leave empty to keep the current logo.</text>
                                    }
                                </small>
                                @if (Model.HasLogo)
                                {
                                    <label class="form-check mt-2">
                                        <input class="form-check-input" type="checkbox" asp-for="RemoveLogo" />
                                        <span class="form-check-label">
                                            Remove the logo — receipts and invoices print without it
                                        </span>
                                    </label>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-footer d-grid d-md-flex justify-content-md-end">
                <button type="submit" class="btn btn-primary">Save Changes</button>
            </div>
        </form>
    </div>
</div>
