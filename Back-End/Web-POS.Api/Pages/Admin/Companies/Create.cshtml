@page
@model Api.Pages.Admin.Companies.CreateModel
@{
    ViewData["Title"] = "Provision New Organization";
}

<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row g-2 align-items-center">
            <div class="col">
                <div class="page-pretitle">Organizations</div>
                <h2 class="page-title">Provision New Organization</h2>
                <div class="text-secondary mt-1">Create a company, configure subscription limits, and set up the initial user.</div>
            </div>
            <div class="col-12 col-md-auto ms-md-auto d-print-none">
                <div class="btn-list d-grid d-md-block">
                    <a class="btn btn-ghost-secondary" asp-page="Index">Back to Dashboard</a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        <form method="post" enctype="multipart/form-data">
            <div class="row row-cards">

                <!-- Company Profile -->
                <div class="col-12">
                    <div class="card">
                        <div class="card-header"><h3 class="card-title">Organization Profile</h3></div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-12 col-md-6">
                                    <label class="form-label required">Company Name</label>
                                    <input class="form-control" asp-for="Input.Name" required placeholder="e.g., Acme Corp" />
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label required">Country</label>
                                    @if (Model.Countries.Count > 0)
                                    {
                                        <select class="form-select" asp-for="Input.CountryId" required>
                                            <option value="">-- Select Country --</option>
                                            @foreach (var c in Model.Countries)
                                            {
                                                <option value="@c.Id">@c.Name (@c.Id)</option>
                                            }
                                        </select>
                                    }
                                    else
                                    {
                                        <input type="number" class="form-control" asp-for="Input.CountryId" placeholder="Country ID" required />
                                        <small class="form-hint">No countries found — enter an existing CountryId.</small>
                                    }
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label">Email Address</label>
                                    <input type="email" class="form-control" asp-for="Input.Email" placeholder="billing@example.com" />
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label">Phone Number</label>
                                    <input type="tel" class="form-control" asp-for="Input.PhoneNumber" placeholder="+1 (555) 000-0000" />
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label">Street Address</label>
                                    <input class="form-control" asp-for="Input.Address" placeholder="123 Main St" />
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label">City</label>
                                    <input class="form-control" asp-for="Input.City" placeholder="Metropolis" />
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label">Postal Code</label>
                                    <input class="form-control" asp-for="Input.PostalCode" placeholder="10001" />
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label">Tax / VAT Number</label>
                                    <input class="form-control" asp-for="Input.TaxNumber" placeholder="XX123456789" />
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Logo</label>
                                    <div class="row g-2 align-items-center">
                                        <div class="col-auto">
                                            <span class="avatar avatar-md" id="logoPreview"
                                                  style="background-image:none">
                                                <span class="text-secondary" id="logoPreviewInitial">—</span>
                                            </span>
                                        </div>
                                        <div class="col">
                                            <input type="file" class="form-control" asp-for="Logo"
                                                   accept="@Api.Admin.CompanyLogoFile.Accept"
                                                   onchange="previewLogo(this)" />
                                            @*  PNG/JPEG is not a stylistic choice: the till prints this
                                                logo through a decoder that reads those two and nothing
                                                else, so a WebP would look right here and print blank. *@
                                            <small class="form-hint">
                                                PNG or JPEG, up to @(Api.Admin.CompanyLogoFile.MaxBytes / 1024 / 1024) MB.
                                                Printed on this company's receipts and invoices. Optional —
                                                it can be added later from Edit.
                                            </small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- SaaS Provisioning -->
                <div class="col-12">
                    <div class="card">
                        <div class="card-header"><h3 class="card-title">SaaS Subscription &amp; Licensing</h3></div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-12 col-md-6">
                                    <label class="form-label">Billing Period</label>
                                    <select class="form-select" asp-for="Input.SubscriptionDays">
                                        <option value="14">14 days (Trial)</option>
                                        <option value="30" selected>1 month (30 days)</option>
                                        <option value="90">3 months (Quarterly)</option>
                                        <option value="180">6 months (Biannual)</option>
                                        <option value="365">1 year (Annual)</option>
                                    </select>
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label">Seat Allowance (Terminals)</label>
                                    <input type="number" class="form-control" min="1" asp-for="Input.SeatAllowance" placeholder="e.g., 5" />
                                    <small class="form-hint">Maximum active devices allowed to sync.</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Initial User -->
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <label class="form-check form-switch form-check-single mb-0">
                                <input class="form-check-input" type="checkbox" asp-for="Input.CreateFirstUser" id="createFirstUserToggle" />
                                <span class="form-check-label h3 mb-0">Provision Initial User</span>
                            </label>
                        </div>
                        <div class="card-body">
                            <div id="firstUserFields" class="row g-3" style="opacity:0.5; pointer-events:none; transition:opacity 0.2s ease;">
                                <div class="col-12 col-md-6 col-lg-4">
                                    <label class="form-label">Username</label>
                                    <input class="form-control" asp-for="Input.Username" autocomplete="new-username" />
                                </div>
                                <div class="col-12 col-md-6 col-lg-4">
                                    <label class="form-label">Password</label>
                                    <input type="password" class="form-control" asp-for="Input.Password" autocomplete="new-password" />
                                </div>
                                <div class="col-12 col-md-6 col-lg-4">
                                    <label class="form-label">Access Level</label>
                                    <select class="form-select" asp-for="Input.AccessLevel">
                                        @foreach (var (value, label) in Api.Domain.AccessLevels.Options)
                                        {
                                            <option value="@value">@label</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-12 col-md-6 col-lg-4">
                                    <label class="form-label">First Name</label>
                                    <input class="form-control" asp-for="Input.FirstName" />
                                </div>
                                <div class="col-12 col-md-6 col-lg-4">
                                    <label class="form-label">Last Name</label>
                                    <input class="form-control" asp-for="Input.LastName" />
                                </div>
                                <div class="col-12 col-md-6 col-lg-4">
                                    <label class="form-label">User Email</label>
                                    <input type="email" class="form-control" asp-for="Input.UserEmail" />
                                </div>
                            </div>
                        </div>
                        @*  d-grid below md makes the submit full-width and thumb-reachable;
                            from md up it returns to a right-aligned button. *@
                        <div class="card-footer d-grid d-md-flex justify-content-md-end">
                            <button type="submit" class="btn btn-primary">Create Organization</button>
                        </div>
                    </div>
                </div>

            </div>
        </form>
    </div>
</div>

<script>
    // UX Enhancement: Greys out the user fields until the toggle is checked
    document.addEventListener("DOMContentLoaded", function () {
        const toggle = document.getElementById("createFirstUserToggle");
        const fields = document.getElementById("firstUserFields");

        function updateState() {
            const on = toggle.checked;
            fields.style.opacity = on ? "1" : "0.5";
            fields.style.pointerEvents = on ? "auto" : "none";

            // Only require credentials while the section is actually in play.
            const username = document.getElementById("Input_Username");
            const password = document.getElementById("Input_Password");
            if (on) {
                username.setAttribute("required", "required");
                password.setAttribute("required", "required");
            } else {
                username.removeAttribute("required");
                password.removeAttribute("required");
            }
        }

        toggle.addEventListener("change", updateState);
        updateState(); // Initialize state on load
    });
</script>

<script>
    function previewLogo(input) {
        var box = document.getElementById('logoPreview');
        var initial = document.getElementById('logoPreviewInitial');
        var file = input.files && input.files[0];
        if (!file) {
            box.style.backgroundImage = 'none';
            initial.style.display = '';
            return;
        }
        var reader = new FileReader();
        reader.onload = function (e) {
            box.style.backgroundImage = 'url(' + e.target.result + ')';
            initial.style.display = 'none';
        };
        reader.readAsDataURL(file);
    }
</script>
