@page "{id:int}"
@model Api.Pages.Admin.Companies.DetailsModel
@{
    ViewData["Title"] = Model.Company?.Name ?? "Organization Details";
}

<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row g-2 align-items-center">
            <div class="col">
                <div class="page-pretitle">Organization #@Model.Company?.Id</div>
                <h2 class="page-title">@Model.Company?.Name</h2>
                <div class="text-secondary mt-1">Organization details, subscription status, and user management</div>
            </div>
            <div class="col-12 col-md-auto ms-md-auto d-print-none">
                <div class="btn-list d-grid d-md-flex">
                    <a class="btn" asp-page="Edit" asp-route-id="@Model.Company?.Id">Edit Organization</a>
                    <a class="btn btn-ghost-secondary" asp-page="Index">Back to Dashboard</a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        <div class="row row-cards">

            <!-- Profile -->
            <div class="col-12 col-lg-6">
                <div class="card h-100">
                    <div class="card-header"><h3 class="card-title">Profile Information</h3></div>
                    <div class="card-body">
                        @*  Tabler's datagrid is an auto-fit grid with a 15rem minimum,
                            so it collapses to a single column on a phone by itself. *@
                        <div class="datagrid">
                            <div>
                                <div class="datagrid-title">Country</div>
                                <div class="datagrid-content">
                                    @Model.Company?.CountryName
                                    <span class="text-secondary">(@Model.Company?.CountryId)</span>
                                </div>
                            </div>
                            <div>
                                <div class="datagrid-title">Email</div>
                                <div class="datagrid-content break-anywhere">@(string.IsNullOrEmpty(Model.Company?.Email) ? "—" : Model.Company?.Email)</div>
                            </div>
                            <div>
                                <div class="datagrid-title">Phone</div>
                                <div class="datagrid-content">@(string.IsNullOrEmpty(Model.Company?.PhoneNumber) ? "—" : Model.Company?.PhoneNumber)</div>
                            </div>
                            <div>
                                <div class="datagrid-title">City</div>
                                <div class="datagrid-content">@(string.IsNullOrEmpty(Model.Company?.City) ? "—" : Model.Company?.City)</div>
                            </div>
                            <div>
                                <div class="datagrid-title">Tax #</div>
                                <div class="datagrid-content break-anywhere">@(string.IsNullOrEmpty(Model.Company?.TaxNumber) ? "—" : Model.Company?.TaxNumber)</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Subscription & Terminals -->
            <div class="col-12 col-lg-6">
                <div class="card h-100">
                    <div class="card-header"><h3 class="card-title">Subscription &amp; Terminals</h3></div>
                    <div class="card-body">
                        @if (!Model.HasTenant)
                        {
                            <div class="text-secondary">No control-plane tenant for this company yet (not provisioned).</div>
                        }
                        else
                        {
                            <div class="datagrid">
                                <div>
                                    <div class="datagrid-title">Billing Status</div>
                                    <div class="datagrid-content">
                                        <span class="status status-green"><span class="status-dot"></span>@Model.BillingStatus</span>
                                    </div>
                                </div>
                                <div>
                                    <div class="datagrid-title">Days Left</div>
                                    <div class="datagrid-content">
                                        @if (Model.SubscriptionDaysLeft == null)
                                        {
                                            <span>—</span>
                                        }
                                        else
                                        {
                                            var dl = Model.SubscriptionDaysLeft.Value;
                                            var toneClass = dl <= 0 ? "text-danger" : (dl <= 7 ? "text-warning" : "");
                                            <span class="fw-bold @toneClass">@dl</span>
                                            <span class="text-secondary">day(s)</span>
                                        }
                                    </div>
                                </div>
                                <div>
                                    <div class="datagrid-title">Expires</div>
                                    <div class="datagrid-content">@(Model.SubscriptionEnd?.ToUniversalTime().ToString("yyyy-MM-dd") ?? "—")</div>
                                </div>
                                <div>
                                    <div class="datagrid-title">Active Devices</div>
                                    <div class="datagrid-content">
                                        @{ var over = Model.RegisteredDevices > Model.SeatAllowance; }
                                        <span class="fw-bold @(over ? "text-danger" : "")">@Model.RegisteredDevices</span>
                                        <span class="text-secondary">/ @Model.SeatAllowance</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Security Audit -->
            <div class="col-12">
                <div class="card @(Model.CloneAlertCount > 0 ? "border-danger" : "")">
                    <div class="card-header">
                        <h3 class="card-title">Security Audit</h3>
                        <div class="card-subtitle">Duplication / Clone Detection (Pillar 5)</div>
                        <div class="card-actions">
                            @if (Model.CloneAlertCount > 0)
                            {
                                <span class="badge bg-danger-lt">@Model.CloneAlertCount Alert(s)</span>
                            }
                            else
                            {
                                <span class="badge bg-success-lt">Secure (0 Alerts)</span>
                            }
                        </div>
                    </div>

                    @if (Model.CloneAlertCount == 0)
                    {
                        <div class="card-body text-secondary">
                            No duplicated transactions detected. Every synced sale was reported by a single unique device.
                        </div>
                    }
                    else
                    {
                        <div class="card-body pb-0">
                            <div class="alert alert-danger" role="alert">
                                The same transaction ID was synced from more than one device. This indicates a terminal's
                                local database was duplicated onto another device (clone or restored backup).
                            </div>
                        </div>
                        <div class="table-scroll-hint">
                            <div class="table-responsive">
                                <table class="table table-vcenter card-table table-min table-mobile-stack">
                                    <thead>
                                        <tr>
                                            <th>Transaction ID</th>
                                            <th>Origin Device</th>
                                            <th>Duplicate Device</th>
                                            <th>Times Seen</th>
                                            <th>Last Seen (UTC)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var a in Model.CloneAlerts)
                                        {
                                            <tr>
                                                <td class="cell-title"><code class="break-anywhere">@a.ClientTxnId</code></td>
                                                <td data-label="Origin"><code class="break-anywhere">@a.FirstDeviceId</code></td>
                                                <td data-label="Duplicate"><code class="text-danger break-anywhere">@a.LastDeviceId</code></td>
                                                <td data-label="Times seen">@a.SeenCount</td>
                                                <td class="text-nowrap" data-label="Last seen">@a.LastSeenUtc.ToString("yyyy-MM-dd HH:mm")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Users -->
            <div class="col-12">
                <div class="card table-scroll-hint">
                    <div class="card-header">
                        <h3 class="card-title">Users</h3>
                        <div class="card-subtitle">@Model.Users.Count total</div>
                        <div class="card-actions">
                            <button type="button" id="btnToggleAddUser" class="btn btn-primary">
                                <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
                                Add User
                            </button>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-vcenter card-table table-min table-mobile-stack" style="--table-min:66rem;">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Username</th>
                                    <th>Name</th>
                                    <th>Email</th>
                                    <th>Role</th>
                                    <th>Status</th>
                                    <th class="w-1"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var u in Model.Users)
                                {
                                    <tr>
                                        <td class="text-secondary" data-label="ID">@u.Id</td>
                                        <td class="cell-title"><span class="fw-bold">@u.Username</span></td>
                                        <td data-label="Name">@(string.IsNullOrEmpty(u.FirstName) && string.IsNullOrEmpty(u.LastName) ? "—" : $"{u.FirstName} {u.LastName}")</td>
                                        <td class="text-secondary break-anywhere" data-label="Email">@(string.IsNullOrEmpty(u.Email) ? "—" : u.Email)</td>
                                        <td data-label="Role">
                                            @if (u.AccessLevel == 1)
                                            {
                                                <span class="badge bg-primary-lt">Admin</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary-lt">Cashier</span>
                                            }
                                        </td>
                                        <td data-label="Status">
                                            @if (u.IsEnabled)
                                            {
                                                <span class="status status-green"><span class="status-dot"></span>Active</span>
                                            }
                                            else
                                            {
                                                <span class="status status-secondary"><span class="status-dot"></span>Disabled</span>
                                            }
                                        </td>
                                        <td class="cell-block" data-label="Actions">
                                            <div class="btn-list flex-nowrap justify-content-end align-items-center">
                                                <a class="btn btn-sm" asp-page="/Admin/Users/Edit" asp-route-id="@Model.Company?.Id" asp-route-userId="@u.Id">Edit</a>

                                                <form method="post" asp-page-handler="ResetPassword" asp-route-id="@Model.Company?.Id" class="m-0">
                                                    <input type="hidden" name="userId" value="@u.Id" />
                                                    <div class="input-group input-group-sm" style="min-width:13rem;">
                                                        <input type="password" name="newPassword" class="form-control" placeholder="New password" aria-label="New password for @u.Username" required />
                                                        <button type="submit" class="btn btn-ghost-warning">Reset</button>
                                                    </div>
                                                </form>

                                                <form method="post" asp-page-handler="DeleteUser" asp-route-id="@Model.Company?.Id" class="m-0"
                                                      onsubmit="return confirm('Delete user @u.Username?');">
                                                    <input type="hidden" name="userId" value="@u.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Add User (hidden by default) -->
            <div class="col-12" id="addUserSection" style="display:none;">
                <div class="card">
                    <div class="card-header"><h3 class="card-title">Provision New User</h3></div>
                    <form method="post" asp-page-handler="AddUser" asp-route-id="@Model.Company?.Id">
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-12 col-md-6 col-lg-4">
                                    <label class="form-label required">Username</label>
                                    <input class="form-control" asp-for="NewUser.Username" required autocomplete="new-username" />
                                </div>
                                <div class="col-12 col-md-6 col-lg-4">
                                    <label class="form-label required">Password</label>
                                    <input type="password" class="form-control" asp-for="NewUser.Password" required autocomplete="new-password" />
                                </div>
                                <div class="col-12 col-md-6 col-lg-4">
                                    <label class="form-label">Role</label>
                                    <select class="form-select" asp-for="NewUser.AccessLevel">
                                        <option value="0">Cashier</option>
                                        <option value="1">Admin</option>
                                    </select>
                                </div>
                                <div class="col-12 col-md-6 col-lg-4">
                                    <label class="form-label">First Name</label>
                                    <input class="form-control" asp-for="NewUser.FirstName" />
                                </div>
                                <div class="col-12 col-md-6 col-lg-4">
                                    <label class="form-label">Last Name</label>
                                    <input class="form-control" asp-for="NewUser.LastName" />
                                </div>
                                <div class="col-12 col-md-6 col-lg-4">
                                    <label class="form-label">Email</label>
                                    <input type="email" class="form-control" asp-for="NewUser.Email" />
                                </div>
                            </div>
                        </div>
                        <div class="card-footer d-grid d-md-flex gap-2 justify-content-md-end">
                            <button type="button" id="btnCancelAddUser" class="btn btn-ghost-secondary order-md-first">Cancel</button>
                            <button type="submit" class="btn btn-primary">Add User</button>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const toggleBtn = document.getElementById("btnToggleAddUser");
        const cancelBtn = document.getElementById("btnCancelAddUser");
        const addUserSection = document.getElementById("addUserSection");

        function toggleAddUserForm() {
            const hidden = addUserSection.style.display === "none" || addUserSection.style.display === "";
            addUserSection.style.display = hidden ? "block" : "none";
            toggleBtn.style.display = hidden ? "none" : "";
            // On a phone the form opens well below the fold — take the operator there.
            if (hidden) addUserSection.scrollIntoView({ behavior: "smooth", block: "start" });
        }

        toggleBtn.addEventListener("click", toggleAddUserForm);
        cancelBtn.addEventListener("click", toggleAddUserForm);
    });
</script>
