@page
@model Api.Pages.Admin.LoginModel
@{
    ViewData["Title"] = "Sign in";
}

<div class="page-body">
    @* container-tight is Tabler's narrow column for sign-in style forms. *@
    <div class="container-tight py-4">
        <div class="text-center mb-4">
            <img src="~/img/icon.svg" alt="" width="72" height="72" style="border-radius:16px;" class="d-inline-block" />
            <h1 class="h2 mt-3 mb-1">POS Admin</h1>
            <p class="text-secondary mb-0">Sign in to manage companies and subscriptions</p>
        </div>

        <form method="post" class="card card-md">
            <div class="card-body">
                <h2 class="card-title text-center mb-4">Sign in to your account</h2>

                @* Carried explicitly rather than relying on the browser resubmitting the
                   query string, so a deep link the operator was challenged on survives the
                   round trip. LoginModel.SafeReturnUrl rejects anything non-local. *@
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
                }

                <div class="mb-3">
                    <label class="form-label" asp-for="Input.Username">Username</label>
                    <input class="form-control" asp-for="Input.Username" autocomplete="username" autofocus required />
                </div>

                <div class="mb-2">
                    <label class="form-label" asp-for="Input.Password">Password</label>
                    <input class="form-control" asp-for="Input.Password" type="password" autocomplete="current-password" required />
                </div>

                <div class="mb-3">
                    <label class="form-check">
                        <input type="checkbox" class="form-check-input" asp-for="Input.RememberMe" id="rememberMe" />
                        <span class="form-check-label">Keep me signed in on this computer</span>
                    </label>
                </div>

                <div class="form-footer">
                    <button type="submit" class="btn btn-primary w-100">Sign in</button>
                </div>
            </div>
        </form>
    </div>
</div>
