@page
@model Api.Pages.Admin.Users.EditModel
@{
    ViewData["Title"] = "Edit User";
}

<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row g-2 align-items-center">
            <div class="col">
                <div class="page-pretitle">User #@Model.Input.UserId</div>
                <h2 class="page-title">Edit User</h2>
                <div class="text-secondary mt-1">Update user profile, role, and system access</div>
            </div>
            <div class="col-12 col-md-auto ms-md-auto d-print-none">
                <div class="btn-list d-grid d-md-block">
                    <a class="btn btn-ghost-secondary" asp-page="/Admin/Companies/Details" asp-route-id="@Model.Input.CompanyId">Cancel &amp; Back</a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        <form method="post" class="card">
            <input type="hidden" asp-for="Input.CompanyId" />
            <input type="hidden" asp-for="Input.UserId" />

            <div class="card-header"><h3 class="card-title">User Profile</h3></div>

            <div class="card-body">
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label class="form-label required">Username</label>
                        <input class="form-control" asp-for="Input.Username" required />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label">Email Address</label>
                        <input type="email" class="form-control" asp-for="Input.Email" placeholder="user@example.com" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label">First Name</label>
                        <input class="form-control" asp-for="Input.FirstName" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label">Last Name</label>
                        <input class="form-control" asp-for="Input.LastName" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label">Role</label>
                        <!-- Converted numeric input to the intuitive Role dropdown -->
                        <select class="form-select" asp-for="Input.AccessLevel">
                            @foreach (var (value, label) in Api.Domain.AccessLevels.Options)
                            {
                                <option value="@value">@label</option>
                            }
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-check form-switch form-check-single">
                            <input class="form-check-input" type="checkbox" asp-for="Input.IsEnabled" id="enabledToggle" />
                            <span class="form-check-label">Account Enabled (Active)</span>
                        </label>
                    </div>
                    <div class="col-12">
                        <div class="alert alert-info mb-0" role="note">
                            To change this user's password, use the <strong>Reset</strong> action on the organization's details page.
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-footer d-grid d-md-flex justify-content-md-end">
                <button type="submit" class="btn btn-primary">Save Changes</button>
            </div>
        </form>
    </div>
</div>
