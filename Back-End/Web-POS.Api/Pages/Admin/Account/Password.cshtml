@page
@model Api.Pages.Admin.Account.PasswordModel
@{
    ViewData["Title"] = "Change password";
}

<div style="max-width:520px;">
    <div class="mb-4 text-main">
        <h3 class="mb-0">Change password</h3>
        <div class="text-muted small mt-1">Signed in as @Model.Username</div>
    </div>

    <form method="post" class="card text-main">
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="card mb-3" role="alert" style="border-left:4px solid #D66; padding:0.75rem;">
                <div class="small">@Model.ErrorMessage</div>
            </div>
        }

        <div class="form-field">
            <label asp-for="Input.CurrentPassword">Current password</label>
            <input asp-for="Input.CurrentPassword" type="password" autocomplete="current-password" required />
        </div>

        <div class="form-field">
            <label asp-for="Input.NewPassword">New password</label>
            <input asp-for="Input.NewPassword" type="password" autocomplete="new-password" required />
            <span class="text-muted small">At least @Api.Pages.Admin.Account.PasswordModel.MinimumLength characters.</span>
        </div>

        <div class="form-field">
            <label asp-for="Input.ConfirmPassword">Confirm new password</label>
            <input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" required />
        </div>

        <div class="d-flex justify-content-end gap-2 mt-3">
            <a class="btn-ghost" asp-page="/Admin/Companies/Index">Cancel</a>
            <button type="submit" class="btn-primary" style="padding:0.6rem 1.6rem;">Update password</button>
        </div>
    </form>
</div>
