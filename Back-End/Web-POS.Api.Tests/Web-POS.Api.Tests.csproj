<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>Api.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <!-- Pinned above what EF Core 10.0.9 drags in (2.1.11), which trips NU1903 for
         GHSA-2m69-gcr7-jv3q. Test-only, but an unactionable high-severity warning
         on every build of the solution is worse than one explicit line here. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Boots the REAL Program.cs pipeline in-process, so the authorization
         conventions under test are the ones that ship. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <!-- Test-only provider. The seeder and AdminUserService are plain EF against
         MasterDbContext, so they run unchanged on SQLite and no live SQL Server is
         needed to pin their logic.
         ⚠️ SQLite compares TEXT case-SENSITIVELY while SQL Server's default
         collation does not — never assert username case behaviour here, it would
         pin the opposite of production. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Web-POS.Api\Web-POS.Api.csproj" />
  </ItemGroup>

</Project>
