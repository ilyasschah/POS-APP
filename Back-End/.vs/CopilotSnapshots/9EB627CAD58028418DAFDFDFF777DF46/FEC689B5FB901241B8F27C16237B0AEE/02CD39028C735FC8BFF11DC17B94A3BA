using Microsoft.EntityFrameworkCore;
using Products.Api.DataBase;
using Products.Api.Domain;

namespace Products.Api.Repository
{
    public class PosPrinterSettingsRepository
    {
        private readonly AppDbContext _db;

        public PosPrinterSettingsRepository(AppDbContext db)
        {
            _db = db;
        }

        public async Task<List<PosPrinterSettings>> GetAllAsync(int companyId)
        {
            // no navigation properties to Include()
            return await _db.PosPrinterSettings
                .Where(x => x.CompanyId == companyId)
                .AsNoTracking()
                .ToListAsync();
        }

        public async Task<List<PosPrinterSettings>> GetAllAsync()
        {
            // no navigation properties to Include()
            return await _db.PosPrinterSettings.AsNoTracking().ToListAsync();
        }

        public async Task<PosPrinterSettings?> GetByIdAsync(int id, bool trackEntity = false)
        {
            var q = _db.PosPrinterSettings.AsQueryable();
            if (!trackEntity) q = q.AsNoTracking();
            return await q.FirstOrDefaultAsync(x => x.Id == id);
        }

        public async Task<PosPrinterSettings?> GetByPrinterNameAsync(string printerName)
        {
            return await _db.PosPrinterSettings
                .AsNoTracking()
                .FirstOrDefaultAsync(x => x.PrinterName == printerName);
        }

        public async Task<bool> ExistsByPrinterNameAsync(string printerName)
        {
            return await _db.PosPrinterSettings.AnyAsync(x => x.PrinterName.ToLower() == printerName.ToLower());
        }

        public async Task AddAsync(PosPrinterSettings entity)
        {
            _db.PosPrinterSettings.Add(entity);
            await _db.SaveChangesAsync();
        }

        public async Task UpdateAsync(PosPrinterSettings entity)
        {
            _db.PosPrinterSettings.Update(entity);
            await _db.SaveChangesAsync();
        }

        public async Task DeleteAsync(PosPrinterSettings entity)
        {
            _db.PosPrinterSettings.Remove(entity);
            await _db.SaveChangesAsync();
        }
    }
}
