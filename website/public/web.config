<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration for the STATIC marketing site (octopus-pos.com).

  This lives in website/public/ on purpose: `next build` copies everything under
  public/ into out/ verbatim, so the file ships with the build and stays in version
  control. Keeping it only on the server means it is one rebuild away from being
  lost, with no record of what it contained.

  Nothing here applies to the API — api.octopus-pos.com is a separate IIS site with
  its own web.config, generated by dotnet publish.
-->
<configuration>
  <system.webServer>

    <!--
      Redirect plain HTTP to HTTPS. The API does this in its own web.config and
      adds HSTS from Program.cs; this static site had neither, so octopus-pos.com
      answered on http:// indefinitely while api. did not.

      The acme-challenge exemption is NOT optional. win-acme proves domain
      ownership over HTTP-01: Let's Encrypt fetches
      http://octopus-pos.com/.well-known/acme-challenge/<token> on PORT 80, and it
      does not follow a redirect to a name it has not yet validated. Without the
      negate rule the certificate still LOOKS fine for ~60 days, then the renewal
      fails and the site goes untrusted - a failure that surfaces long after the
      change that caused it. Port 80 must stay open for the same reason.

      This needs the URL Rewrite module (IIS does not ship it). If it is ever
      missing, the whole site returns 500.19 rather than just skipping the rule.
    -->
    <rewrite>
      <rules>
        <rule name="HTTP to HTTPS redirect" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
            <add input="{REQUEST_URI}" pattern="^/\.well-known/acme-challenge/" negate="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
      </rules>
    </rewrite>

    <staticContent>
      <!--
        IIS serves NOTHING whose extension it has no MIME map for - it answers a
        flat 404 for a file that is sitting right there on disk, which is a
        genuinely confusing failure. .webp is not mapped by default on Windows
        Server, and brand-mark.webp is this site's logo.

        Each <remove> guards its <mimeMap>: if the server already knows the type,
        adding a duplicate is a 500 (HTTP Error 500.19, duplicate collection
        entry) - and that takes down the WHOLE site, not just the image.
      -->
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".avif" />
      <mimeMap fileExtension=".avif" mimeType="image/avif" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
    </staticContent>

    <!-- Serve the exported 404 page rather than the IIS default, which leaks the
         server version and looks nothing like the site. -->
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="/404.html" responseMode="ExecuteURL" />
    </httpErrors>

    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <!-- Remove the IIS version banner. -->
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

  </system.webServer>

  <!--
    Next.js fingerprints everything under _next/static with a content hash, so a
    given URL's bytes never change - it is safe to cache for a year, and a deploy
    that changes an asset changes its URL too. Without this every visitor
    re-downloads the whole bundle on every visit.
  -->
  <location path="_next/static">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>

</configuration>
